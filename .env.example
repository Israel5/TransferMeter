# Copy to .env and fill in. .env is gitignored and must stay that way.


# --- Google Maps Platform -------------------------------------- deployed ---
# Routes API and Places API (New). Read on the server only; it never reaches a
# browser, which is why the app proxies Google through /api.
GOOGLE_MAPS_API_KEY=

# Biases address autocomplete to one country. Defaults to ca.
ADDRESS_LOOKUP_COUNTRY=ca


# --- Supabase, in the browser ---------------------------------- deployed ---
# Compiled into the bundle at build time. Both are public by design: the anon
# key identifies the project and grants nothing on its own, because every table
# privilege is revoked from the anon role. Access opens only once you sign in
# and row-level security sees your id.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# --- Supabase, administration ---------------------------- local only -------
# NOT for Vercel, and read by no deployed file. The service key bypasses every
# row-level security policy; the connection string carries your database
# password. Both are for running migrations and scripts/set-password.mjs.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
