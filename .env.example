# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Nothing here reaches a browser except the one variable marked public. The app
# talks to its own /api routes; those routes talk to Google and to the database.
# A page never holds a key, a database address, or a session token.


# --- Google Maps Platform -------------------------------------- deployed ---
# Routes API and Places API (New), read on the server only.
GOOGLE_MAPS_API_KEY=

# Biases address autocomplete to one country. Defaults to ca.
ADDRESS_LOOKUP_COUNTRY=ca


# --- Supabase ---------------------------------------------------- deployed ---
# Server-side only. The anon key grants nothing on its own -- every table
# privilege is revoked from it -- but it no longer ships to browsers either.
SUPABASE_URL=
SUPABASE_ANON_KEY=


# --- The public request form ----------------------------------- deployed ---
# The Turnstile site key belongs in the page; that is what a site key is for.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The secret is checked server-side. Without it the form refuses every request.
TURNSTILE_SECRET_KEY=
# Proves a request came through the form's route. Matches config.request_secret.
QUOTE_REQUEST_SECRET=


# --- Administration ---------------------------------------- local only -----
# NOT for Vercel, and read by no deployed file. Migrations and set-password.
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
