# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# On Vercel, set only the variables marked "deployed". The rest are for
# working on the project from your own machine.


# --- Google Maps Platform -------------------------------------- deployed ---
# Routes API and Places API (New). Read on the server only; it is never sent
# to a browser, which is why the app proxies Google through /api instead of
# calling it directly.
GOOGLE_MAPS_API_KEY=

# Biases address autocomplete to one country. Defaults to ca.
ADDRESS_LOOKUP_COUNTRY=ca


# --- Supabase ---------------------------------------------------------------
# These two are handed to the browser by /api/config and turn on sign-in and
# shared storage. Leave them empty and the app runs standalone, keeping
# everything in that browser.
#
# The anon key is public by design: it identifies the project and grants
# nothing on its own. Every table privilege is revoked from the anon role, so
# access opens only once a user signs in and row-level security sees their id.
SUPABASE_URL=                                              # deployed
SUPABASE_ANON_KEY=                                         # deployed

# Only used if SUPABASE_ANON_KEY is missing. Setting both invites them to drift.
SUPABASE_PUBLISHABLE_KEY=

# --- administration, local only ---------------------------------------------
# NOT for Vercel, and read by no deployed file. The service key bypasses every
# row-level security policy; the connection string carries your database
# password. Both are for running migrations from your own machine.
SUPABASE_SERVICE_KEY=
SUPABASE_DB_URL=
