# Copy to .env and fill in. .env is gitignored and must stay that way.

# Google Maps Platform — Routes + Places. Stays server-side, never in a browser.
GOOGLE_MAPS_API_KEY=
ADDRESS_LOOKUP_COUNTRY=ca

# Local dev server
PORT=8787
TRANSFER_DB=data.db

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=          # safe in the browser; row-level security is the guard
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_KEY=       # server only — never ships to a browser or a repo
SUPABASE_DB_URL=            # for migrations
